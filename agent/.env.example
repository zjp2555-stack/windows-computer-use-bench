# ===== 密钥（必填两个） =====
# 硅基流动：决策原语 systemone / diffusiongemma
SILICONFLOW_API_KEY=
# 智谱开放平台：宿主 LLM（open.bigmodel.cn 单独创建，ZCode 套餐密钥不可用）
ZHIPU_API_KEY=
# 智谱对话模型 ID，按账号可用模型调整（如 glm-4.6 / glm-5.x）
ZHIPU_MODEL=glm-4.6

# ===== 可选（以下均有默认值） =====
# 决策后端：siliconflow | typesafe
DECISION_BACKEND=siliconflow
# 官方 Jev 后端密钥（仅切换 typesafe 时需要）
TYPESAFE_API_KEY=
# 决策置信度低于该值时回退 GLM 直选
CONFIDENCE_THRESHOLD=0.6
# true=只打印动作不真执行（安全默认）
EXEC_DRY_RUN=true
# 每步候选动作数上限（远低于 255）
MAX_CANDIDATES=12
# 单任务最大步数
MAX_STEPS=15
# 代理 fake-ip 模式放行开关（198.18.0.0/15 段）
HTTP_ALLOW_FAKE_IP=false
