# Decision backend: siliconflow (default, diffusiongemma via SiliconFlow) or typesafe (TypeSafe official / Vercel gateway)
DECISION_BACKEND=siliconflow

# SiliconFlow SystemOne decision model (https://cloud.siliconflow.cn)
SILICONFLOW_API_KEY=
# SILICONFLOW_MODEL=diffusiongemma

# GLM writer for free text when not running under an MCP host (https://open.bigmodel.cn)
ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4.6
# ZHIPU_VISION_MODEL=glm-4.6v

# Only needed with DECISION_BACKEND=typesafe
# TYPESAFE_API_KEY=

CLICKER_EMAIL=
# Set true when a local Clash/mihomo proxy uses fake-ip DNS (198.18.0.0/15)
# HTTP_ALLOW_FAKE_IP=false
